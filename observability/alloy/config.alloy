// Grafana Alloy (ADR-0064) — the single collector for every application on
// the VPS. Opt-in per container, through Docker labels:
//
//   observability.enable=true          required — nothing else is read
//   observability.app=<name>           optional — defaults to the Compose project
//   observability.deployment=<name>    optional — prod | staging | … (default: prod)
//   observability.metrics.port=<port>  optional — scrape http://<container>:<port><path>
//   observability.metrics.path=<path>  optional — default /metrics
//
// Logs are read through the Docker socket: no network is needed, so a
// container that must stay private (PHP-FPM speaks unauthenticated FastCGI)
// still has its logs collected. Metrics and traces need the external
// `observability` network: Alloy scrapes there, and the application sends
// its traces to http://observability-alloy:4318 there.
//
//  1. Logs: stdout of each opted-in container → Loki, labelled by app,
//     deployment, service and level. Laravel JSON lines (Monolog
//     JsonFormatter) are parsed; correlation_id / trace_id / project_id stay
//     structured metadata, never labels (unbounded cardinality).
//  2. Metrics: scraped every 30 s, pushed to Prometheus (remote write).
//  3. Traces: OTLP/HTTP (4318) or gRPC (4317) → Tempo.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  // Par défaut Alloy ne retient que le PREMIER réseau (par ordre alphabétique) de chaque conteneur : un projet sur
  // nginx-proxy, observability et son réseau privé n'aurait jamais sa cible de métriques sur « observability ».
  match_first_network = false
}

// Common to logs and metrics: opted-in containers. A container on several
// networks is listed once per network by the Docker API; loki.source.docker
// tails it once all the same (verified: 2 networks → no duplicate line).
discovery.relabel "opted_in" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_observability_enable"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__meta_docker_container_label_observability_app"]
    regex         = "(.+)"
    target_label  = "app"
  }
  rule {
    target_label = "deployment"
    replacement  = "prod"
  }
  rule {
    source_labels = ["__meta_docker_container_label_observability_deployment"]
    regex         = "(.+)"
    target_label  = "deployment"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// ── Logs ────────────────────────────────────────────────────────────────
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.opted_in.output
  forward_to = [loki.process.laravel.receiver]
}

loki.process "laravel" {
  // Laravel's JsonFormatter line: {"message","context","level_name","extra":{…}}.
  // A non-JSON line (another framework, a crash trace) goes through as is.
  stage.json {
    expressions = {
      level          = "level_name",
      level_caddy    = "level",
      correlation_id = "extra.correlation_id",
      trace_id       = "extra.trace_id",
      project_id     = "extra.project_id",
      environment    = "extra.environment",
    }
  }

  // One « level » label whatever the emitter: Laravel writes level_name (« ERROR », « WARNING »), Caddy and
  // FrankenPHP write level (« error », « warn »). Upper case, and « WARN » becomes « WARNING », the way the
  // Applications dashboard and the alerts spell it.
  stage.template {
    source   = "level"
    template = "{{ $l := \"\" }}{{ if .Value }}{{ $l = ToUpper .Value }}{{ else if .level_caddy }}{{ $l = ToUpper .level_caddy }}{{ end }}{{ if eq $l \"WARN\" }}WARNING{{ else }}{{ $l }}{{ end }}"
  }

  stage.labels {
    values = {
      level       = "",
      environment = "",
    }
  }

  stage.structured_metadata {
    values = {
      correlation_id = "",
      trace_id       = "",
      project_id     = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ── Metrics ─────────────────────────────────────────────────────────────
discovery.relabel "metrics" {
  targets = discovery.relabel.opted_in.output

  rule {
    source_labels = ["__meta_docker_container_label_observability_metrics_port"]
    regex         = ".+"
    action        = "keep"
  }
  // Scrape on the shared network only — once, and where Alloy can reach it.
  rule {
    source_labels = ["__meta_docker_network_name"]
    // `observability` unless overridden (tests run an isolated copy).
    regex         = coalesce(sys.env("OBS_NETWORK"), "observability")
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_ip", "__meta_docker_container_label_observability_metrics_port"]
    separator     = ":"
    target_label  = "__address__"
  }
  rule {
    source_labels = ["__meta_docker_container_label_observability_metrics_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
}

prometheus.scrape "applications" {
  targets         = discovery.relabel.metrics.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ── Traces ──────────────────────────────────────────────────────────────
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
