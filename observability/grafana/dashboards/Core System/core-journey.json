{
  "uid": "core-journey",
  "title": "Core — Parcours d'une requête",
  "tags": [
    "core-system"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "deployment",
        "label": "Déploiement",
        "type": "custom",
        "query": "prod,staging",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          }
        ]
      },
      {
        "name": "correlation_id",
        "label": "Correlation-Id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "trace_id",
        "label": "Trace id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Mode d'emploi",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Collez le **Correlation-Id** renvoyé par l'API (en-tête `Correlation-Id`, ou champ `correlation_id` d'une erreur) : toutes les lignes de la requête, des appels provider et des jobs qu'elle a déclenchés (livraisons webhook, callbacks) s'affichent dans l'ordre. Le **trace id** de n'importe quelle ligne ouvre la trace complète dans Tempo."
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Toutes les lignes de la requête (correlation_id)",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"core-system\", deployment=\"$deployment\", service=~\".+\"} | correlation_id = `$correlation_id`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Échanges HTTP entrants (requête → réponse)",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"core-system\", deployment=\"$deployment\", service=\"app\"} | correlation_id = `$correlation_id` | json | message =~ \"http\\\\.(request|response).*\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Appels provider et livraisons sortantes",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"core-system\", deployment=\"$deployment\", service=~\".+\"} | correlation_id = `$correlation_id` | json | message =~ \"integration\\\\..*|webhook\\\\..*|payment\\\\.callback.*\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 5,
      "type": "traces",
      "title": "Trace (Tempo)",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "$trace_id"
        }
      ]
    }
  ]
}
