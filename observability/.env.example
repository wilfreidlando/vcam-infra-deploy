# Shared observability platform (ADR-0064). Copy to infra/observability/.env
# on the VPS — never commit the filled-in file.

# Public name of Grafana, routed by the existing nginx-proxy (certificate by
# acme-companion, automatic once the wildcard DNS record exists).
GRAFANA_HOST=grafana.visibilitycam.com
LETSENCRYPT_EMAIL=ops@visibilitycam.com

GRAFANA_ADMIN_USER=admin
# openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Alerts (Core production only). SMTP is needed for e-mail delivery.
GRAFANA_ALERT_EMAIL=ops@visibilitycam.com
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=grafana@visibilitycam.com

PROMETHEUS_RETENTION=30d
LOKI_MEMORY_LIMIT=1G
