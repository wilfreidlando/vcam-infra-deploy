{
  "permissions": {
    "allow": [
      "Bash(ssh vps-contabo /app/vps-platform/bin/vps-inventory.sh:*)",
      "Bash(ssh vps-contabo /app/vps-platform/bin/vps-audit.sh:*)",
      "Bash(ssh vps-contabo /app/vps-platform/bin/vps-hosts.sh:*)",
      "Bash(ssh vps-contabo docker ps:*)",
      "Bash(ssh vps-contabo docker network inspect:*)",
      "Bash(ssh vps-contabo docker network ls:*)",
      "Bash(ssh vps-contabo docker compose ls:*)",
      "Bash(ssh vps-contabo docker stats --no-stream:*)",
      "Bash(ssh vps-contabo crontab -l:*)",
      "Bash(ssh vps-contabo df:*)",
      "Bash(ssh vps-contabo free:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.config/vcam/**)",
      "Read(**/.env)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Bash(cat ~/.ssh:*)",
      "Bash(cat ~/.config/vcam:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD\\:main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/garde-serveur.sh"
          }
        ]
      }
    ]
  }
}
