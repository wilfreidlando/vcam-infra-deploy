# Platform variables to add to each environment's env file (.env for
# production, .env.staging for staging) — next to the project's own ones.

# ── Identity of this deployment ──────────────────────────────────────────
DEPLOYMENT=prod                       # staging dans .env.staging
ENV_FILE=.env                         # .env.staging dans .env.staging
VIRTUAL_HOST=mon-saas.visibilitycam.com          # staging : mon-saas-staging.visibilitycam.com
LETSENCRYPT_EMAIL=ops@visibilitycam.com

# ── Resources (staging: smaller) ─────────────────────────────────────────
APP_MEMORY=768M
APP_CPUS=1.0

# ── Backups (infra/images/db-backup) ─────────────────────────────────────
BACKUP_PASSPHRASE=                    # openssl rand -base64 32 — copie hors du serveur !
BACKUP_CRON=45 2 * * *                # décaler d'un projet à l'autre
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.s4.mega.io
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# ── Observability (infra/observability) ─────────────────────────────────
LOG_CHANNEL=stdout_json
OTEL_SERVICE_NAME=mon-saas
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-alloy:4318
