# Frontend project — copy to the project root as platform.env.
APP_NAME=mon-front
COMPOSE_FILE=compose.prod.yaml
ENV_FILE_PROD=.env
ENV_FILE_STAGING=.env.staging
STAGING_BRANCH=main

HEALTH_SERVICE=mon-front-web
HEALTH_CMD="wget -qO- http://127.0.0.1:8080/healthz"   # Next.js : http://127.0.0.1:3000/
HEALTH_TIMEOUT=60

# SPA with runtime config: 0 (one image promoted). Next.js with NEXT_PUBLIC_*: 1.
BUILD_PER_ENV=0
