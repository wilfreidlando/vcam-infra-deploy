# STAGING — variables de la plateforme à ajouter au .env.staging du serveur (/app/<projet>/staging/.env.staging, droits 600).
# Jamais les secrets de la production : APP_KEY, mots de passe, jetons et clés de fournisseurs sont ICI des valeurs de test.

# ── Identity of this deployment ──────────────────────────────────────────
DEPLOYMENT=staging
ENV_FILE=.env.staging
# Nom public. Surtout PAS « VIRTUAL_HOST » ici : ce fichier est chargé dans
# tous les conteneurs, seul le conteneur web doit se déclarer à nginx-proxy.
APP_PUBLIC_HOST=mon-saas-staging.visibilitycam.com
LETSENCRYPT_EMAIL=ops@visibilitycam.com

# ── Resources (le staging est plus petit) ─────────────────────────────────────────
APP_MEMORY=512M
APP_CPUS=0.5

# ── Backups ─────────────────────────────────────────────────────────────────
# Le staging n'est PAS sauvegardé (données jetables) : l'agent le dit et reste « healthy ». Les sauvegardes ne vivent que sur S3 (ADR-0067) ;
# pour sauvegarder le staging, renseigner S3 avec son PROPRE BACKUP_S3_PREFIX et retirer BACKUP_DISABLED.
BACKUP_DISABLED=1
BACKUP_TIME=03:15                     # UTC — décaler d'un projet à l'autre
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Observability (observability) ─────────────────────────────────
# Journaux en JSON, sans code : Alloy lit « level_name » et en fait l'étiquette « level » dans Grafana.
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
OTEL_SERVICE_NAME=mon-saas-staging
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-alloy:4318
