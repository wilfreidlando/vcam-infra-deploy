# Committed at the project's root: how bin/deploy.sh deploys this
# project. No secrets here — those live in .env (prod) / .env.staging.

# Unique on the VPS. Compose projects become <APP_NAME>-staging / <APP_NAME>-prod.
APP_NAME=mon-saas
COMPOSE_FILE=compose.prod.yaml
ENV_FILE_PROD=.env
ENV_FILE_STAGING=.env.staging

# BRANCHES : le projet choisit, la plateforme n'impose rien. Exemples :
#   « develop » pour le staging et « main » pour la production    → BRANCH_STAGING=develop  et  BRANCH_PROD=main
#   « main » pour les deux (la production reçoit ce que le staging a validé) → STAGING_BRANCH=main, pas de BRANCH_PROD
# BRANCH_STAGING (ou l'ancien nom STAGING_BRANCH) : la branche que `deploy.sh watch` suit pour le staging (défaut : main).
# BRANCH_PROD (OPTIONNEL) : une GARDE. `deploy.sh promote` refuse une version qui n'est pas déjà dans origin/<branche> : on fusionne d'abord
#   ce que le staging a validé, puis on promeut. L'image reste CELLE DU STAGING (jamais reconstruite). Sans BRANCH_PROD : aucune contrainte.
#   Une autre production a sa propre branche : BRANCH_PRODEU=release. Exception ponctuelle, avec l'accord du responsable : SKIP_BRANCH_CHECK=1.
STAGING_BRANCH=main
# BRANCH_PROD=main

# Optional: more environments than staging + prod. Each extra <env> needs
# BRANCH_<ENV> (watched by `deploy.sh watch <env>`) and its env file
# ENV_FILE_<ENV> (default .env.<env>). A production is never watched: promote only.
# Names: lowercase letters and digits only (prod, prodeu, staging).
# ENVIRONMENTS="dev staging prod"
# BRANCH_DEV=develop
# ENV_FILE_DEV=.env.dev
#
# Project profiles (docs/reference/profils-de-projet.md):
#   - no staging, a single production:   ENVIRONMENTS=prod   and   BRANCH_PROD=main (the branch it follows)
#       deploy with `deploy.sh promote` : it builds origin/<BRANCH_PROD> on the spot (or `promote <sha>` for a given version)
#   - several productions (a client, a region each):
#       ENVIRONMENTS="staging prod prodeu"
#       PROD_ENVIRONMENTS="prod prodeu"       # default: prod
#       deploy with `deploy.sh promote --env prodeu`; each has its own folder, env file and secrets

# Health: run inside HEALTH_SERVICE; must exit 0 when the app can serve.
HEALTH_SERVICE=mon-saas-web
HEALTH_CMD="curl -fsS http://127.0.0.1:8000/up"
HEALTH_TIMEOUT=120

# Optional: run before switching traffic (same image as the new version).
MIGRATE_SERVICE=mon-saas-web
MIGRATE_CMD="php artisan migrate --force"

# Optional: the project's OWN Grafana dashboards and alert rules, delivered in its repo (default folder: observability/ with
# dashboards/*.json and alerts/*.yaml). Published after a successful production deploy, or on demand: `deploy.sh obs-sync`.
# Guide 19. Nothing to set unless the folder has another name.
# OBS_BUNDLE=observability
#
# Optional: the backup agent (images/db-backup). The nightly backup is the safety net; `deploy.sh backup` takes one
# by hand (before a risky migration). deploy.sh takes none at deploy time unless BACKUP_BEFORE_DEPLOY=always.
BACKUP_SERVICE=backup
# BACKUP_BEFORE_DEPLOY=never          # default; "always" = a backup before every production deploy
DB_SERVICE=mon-saas-db
