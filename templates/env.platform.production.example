# PRODUCTION — variables de la plateforme à ajouter au .env du serveur (/app/<projet>/prod/.env, droits 600), à côté de celles du projet.
# Le fichier jumeau pour le staging : env.platform.staging.example. Les valeurs de chaque environnement sont DIFFÉRENTES (secrets compris).

# ── Identity of this deployment ──────────────────────────────────────────
DEPLOYMENT=prod
ENV_FILE=.env
# Nom public. Surtout PAS « VIRTUAL_HOST » ici : ce fichier est chargé dans
# tous les conteneurs, seul le conteneur web doit se déclarer à nginx-proxy.
APP_PUBLIC_HOST=mon-saas.visibilitycam.com
LETSENCRYPT_EMAIL=ops@visibilitycam.com

# ── Resources ─────────────────────────────────────────
APP_MEMORY=768M
APP_CPUS=1.0

# ── Backups (images/db-backup) : OBLIGATOIRES en production ──
# Les sauvegardes vivent sur S3, jamais sur le serveur : sans BACKUP_S3_BUCKET l'agent REFUSE de sauvegarder (ADR-0067).
# BACKUP_PASSPHRASE : à conserver AUSSI hors du serveur (gestionnaire de mots de passe), sans elle aucune restauration.─────────
BACKUP_PASSPHRASE=                    # openssl rand -base64 32 — copie hors du serveur !
BACKUP_TIME=02:45                     # UTC — décaler d'un projet à l'autre
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.s4.mega.io
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1

# ── Observability (observability) ─────────────────────────────────
# Journaux en JSON, sans code : Alloy lit « level_name » et en fait l'étiquette « level » dans Grafana.
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
OTEL_SERVICE_NAME=mon-saas
OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-alloy:4318

# Mot de passe du cache (Valkey/Redis) : OBLIGATOIRE, différent par environnement. openssl rand -base64 24 | tr -d '/+=' ; jamais commité.
REDIS_PASSWORD=
